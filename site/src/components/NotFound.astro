---
import {Image} from 'astro:assets';
import {getRelativeLocaleUrl} from 'astro:i18n';
import backdrop from '../assets/backdrop.png';
import {copy} from '../data/taerra';

const t = copy(Astro.currentLocale).notFound;
---

<main class="not-found">
    <Image class="backdrop" src={backdrop} alt="" layout="full-width" priority />
    <div class="container section">
        <div class="heading">
            <p class="kicker pixel">404</p>
            <h1 class="title">{t.heading}</h1>
            <p class="lede">{t.text}</p>
        </div>
        <div class="actions">
            <a class="btn btn--primary" href={getRelativeLocaleUrl(Astro.currentLocale ?? 'en')}>
                {t.back}
            </a>
        </div>
    </div>
    <div class="edge"></div>
</main>

<style>
    .not-found {
        position: relative;
        display: grid;
        grid-template-rows: 1fr auto;
        align-items: center;
        min-height: calc(100svh - 64px);
        overflow: hidden;
        isolation: isolate;
    }

    .not-found :global(.backdrop) {
        position: absolute;
        inset: 0;
        z-index: -1;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.35;
        animation: drift 40s ease-in-out infinite alternate;
    }

    .not-found::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
                45deg,
                rgb(255 255 255 / 0.04) 25%,
                transparent 25% 50%,
                rgb(255 255 255 / 0.04) 50% 75%,
                transparent 75%
            )
            0 0 / 16px 16px;
    }

    @keyframes drift {
        from {
            scale: 1.04;
        }

        to {
            scale: 1.1;
            translate: 1% -1%;
        }
    }

    .heading > *,
    .actions {
        animation: rise 0.9s var(--ease-out) both;
    }

    .heading > :nth-child(2) {
        animation-delay: 0.08s;
    }

    .heading > :nth-child(3) {
        animation-delay: 0.16s;
    }

    .actions {
        animation-delay: 0.24s;
    }
</style>
