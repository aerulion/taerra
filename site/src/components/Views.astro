---
import {Picture} from 'astro:assets';
import detail from '../assets/detail.png';
import topDown from '../assets/top-down.png';
import nether from '../assets/nether.png';
import end from '../assets/end.png';
import {copy} from '../data/taerra';

const {views} = copy(Astro.currentLocale);
const {rows} = views;
const formats: 'avif'[] = ['avif'];
---

<section id="features" class="section" aria-labelledby="views-title">
    <div class="container">
        <div class="heading" data-reveal>
            <p class="kicker pixel">{views.kicker}</p>
            <h2 id="views-title" class="title">
                {views.title}
            </h2>
            <p class="lede">{views.lede}</p>
        </div>

        <div class="row">
            <Picture
                class="shot"
                data-reveal
                src={detail}
                {formats}
                fallbackFormat="webp"
                width={720}
                alt={rows.detail.alt}
            />
            <div class="text" data-reveal style="--stagger: 1">
                <h3>{rows.detail.title}</h3>
                <p>{rows.detail.text}</p>
            </div>
        </div>

        <div class="row row--flip">
            <Picture
                class="shot"
                data-reveal
                src={topDown}
                {formats}
                fallbackFormat="webp"
                width={720}
                alt={rows.topDown.alt}
            />
            <div class="text" data-reveal style="--stagger: 1">
                <h3>{rows.topDown.title}</h3>
                <p>{rows.topDown.text}</p>
            </div>
        </div>

        <div class="row">
            <div class="plates" data-reveal>
                <Picture src={nether} {formats} fallbackFormat="webp" width={360} alt={rows.dimensions.nether} />
                <Picture src={end} {formats} fallbackFormat="webp" width={360} alt={rows.dimensions.end} />
            </div>
            <div class="text" data-reveal style="--stagger: 1">
                <h3>{rows.dimensions.title}</h3>
                <p>{rows.dimensions.text}</p>
            </div>
        </div>
    </div>
</section>

<style>
    .row {
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
        align-items: center;
        gap: clamp(24px, 4vw, 56px);
    }

    .row + .row {
        margin-top: clamp(56px, 8vw, 112px);
    }

    .row--flip > .text {
        order: -1;
    }

    .row :global(.shot) {
        width: 100%;
        border: 2px solid var(--black);
        border-bottom: 6px solid var(--accent);
        box-shadow: 0 16px 40px rgb(0 0 0 / 0.6);
    }

    .plates {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .plates :global(picture) {
        animation: float 4s ease-in-out infinite alternate;
    }

    .plates :global(picture:nth-child(2)) {
        animation-delay: -2s;
    }

    .plates :global(img) {
        width: 100%;
        filter: drop-shadow(0 16px 24px rgb(0 0 0 / 0.7));
    }

    .text {
        display: grid;
        gap: 16px;
    }

    h3 {
        font-size: clamp(26px, 2.6vw, 34px);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.015em;
        text-wrap: balance;
    }

    .text p {
        color: var(--stone-100);
        text-wrap: pretty;
    }

    @media (max-width: 860px) {
        .row {
            grid-template-columns: minmax(0, 1fr);
        }

        .row--flip > .text {
            order: 0;
        }
    }
</style>
