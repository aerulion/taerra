---
import {getRelativeLocaleUrl} from 'astro:i18n';
import {copy} from '../data/taerra';

const {start} = copy(Astro.currentLocale);
const [before, link, after] = start.more;
const download = getRelativeLocaleUrl(Astro.currentLocale ?? 'en', 'download/');
---

<section id="start" class="section" aria-labelledby="start-title">
    <div class="container">
        <div class="heading" data-reveal>
            <p class="kicker pixel">{start.kicker}</p>
            <h2 id="start-title" class="title">
                {start.title}
            </h2>
        </div>
        <ol class="steps">
            {start.steps.map(({title, text, command}, i) => (
                <li data-reveal style={`--stagger: ${i % 3}`}>
                    <span class="number pixel" aria-hidden="true">
                        {i + 1}
                    </span>
                    <h3>{title}</h3>
                    <p>{text}</p>
                    {command && <code>{command}</code>}
                </li>
            ))}
        </ol>
        <dl class="requirements">
            {Object.values(start.requirements).map(({part, needs}) => (
                <div>
                    <dt class="pixel">{part}</dt>
                    <dd>{needs}</dd>
                </div>
            ))}
        </dl>
        <p class="more">
            {before}
            <a href={download}>{link}</a>
            {after}
        </p>
    </div>
</section>

<style>
    .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        padding: 0;
        list-style: none;
    }

    li {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        gap: 12px;
        padding: 24px;
        background: var(--stone-900);
        border: 2px solid var(--black);
        box-shadow: var(--slab-shadow);
    }

    .number {
        color: var(--accent-hi);
        font-size: 30px;
    }

    h3 {
        font-size: 22px;
        font-weight: 800;
    }

    li p {
        color: var(--stone-100);
        font-size: 16px;
    }

    code {
        display: block;
        padding: 10px 12px;
        overflow-wrap: anywhere;
        background: var(--black);
        color: var(--stone-100);
        box-shadow: inset 0 2px rgb(0 0 0 / 0.6);
    }

    .requirements {
        display: grid;
        gap: 12px;
        margin-top: 40px;
    }

    .requirements div {
        display: grid;
        grid-template-columns: 96px minmax(0, 1fr);
        align-items: baseline;
        gap: 8px 20px;
    }

    dt {
        color: var(--accent-hi);
        font-size: 10px;
    }

    dd {
        color: var(--stone-100);
    }

    @media (max-width: 960px) {
        .steps {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 600px) {
        .steps {
            grid-template-columns: minmax(0, 1fr);
        }

        .requirements div {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .more {
        margin-top: 24px;
        color: var(--stone-200);
        font-size: 16px;
    }
</style>
