---
import {copy} from '../data/taerra';

const {label, groups} = copy(Astro.currentLocale).features;
---

<section class="section features" aria-label={label}>
    <div class="container">
        {groups.map(({kicker, title, features}) => (
            <div class="group">
                <div class="heading" data-reveal>
                    <p class="kicker pixel">{kicker}</p>
                    <h2 class="title">{title}</h2>
                </div>
                <ul class="cards" style={`--columns: ${features.length % 3 ? 4 : 3}`}>
                    {features.map((feature, i) => (
                        <li data-reveal style={`--stagger: ${i % 4}`}>
                            <h3>{feature.title}</h3>
                            <p>{feature.text}</p>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
</section>

<style>
    .features {
        padding-top: 0;
    }

    .group + .group {
        margin-top: var(--section);
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
        gap: 16px;
        padding: 0;
        list-style: none;
    }

    li {
        position: relative;
        display: grid;
        align-content: start;
        gap: 10px;
        padding: 28px 24px 24px;
        background: var(--stone-900);
        border: 2px solid var(--black);
        box-shadow: var(--slab-shadow);
        transition:
            translate 0.4s var(--ease-out),
            box-shadow 0.4s var(--ease-out);
    }

    li::before {
        content: '';
        position: absolute;
        top: 0;
        left: 24px;
        width: 24px;
        height: 4px;
        background: var(--accent-hi);
        transition: width 0.4s var(--ease-out);
    }

    li:hover {
        translate: 0 -4px;
        box-shadow:
            inset 0 2px rgb(255 255 255 / 0.1),
            0 16px 32px rgb(0 0 0 / 0.6);
    }

    li:hover::before {
        width: 48px;
    }

    h3 {
        font-size: 20px;
        font-weight: 800;
        line-height: 1.2;
    }

    li p {
        color: var(--stone-100);
        font-size: 16px;
    }

    @media (max-width: 960px) {
        .cards {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 600px) {
        .cards {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
