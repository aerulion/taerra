---
import {Image} from 'astro:assets';
import icon from '../../../plugin/src/main/resources/web/images/icon.svg';
import {getRelativeLocaleUrl} from 'astro:i18n';
import AerulionFooter from './aerulion/AerulionFooter.astro';
import {PUBLIC_COMMIT_HASH} from 'astro:env/server';
import Download from '../icons/download.svg';
import Pin from '../icons/pin.svg';
import Book from '../icons/book.svg';
import Code from '../icons/code.svg';
import Mail from '../icons/mail.svg';
import discord from '../assets/platforms/discord-white.svg';
import {copy, links} from '../data/taerra';
import {commitUrl} from '../data/downloads';

const {header, hero, footer} = copy(Astro.currentLocale);
const home = getRelativeLocaleUrl(Astro.currentLocale ?? 'en');
const download = getRelativeLocaleUrl(Astro.currentLocale ?? 'en', 'download/');
const nav = [
    {label: footer.nav.download, href: download, Icon: Download},
    {label: footer.nav.demo, href: links.demo, Icon: Pin},
    {label: footer.nav.discord, href: links.discord, Icon: undefined},
    {label: footer.nav.source, href: links.source, Icon: Code},
    {label: footer.nav.deepDive, href: links.deepDive, Icon: Book},
    {label: footer.nav.contact, href: links.contact, Icon: Mail}
];
---

<footer>
    <div class="page">
        <div class="container">
            <div class="top">
                <div class="brand">
                    <a class="lockup pixel" href={`${home}#top`} aria-label={header.home}>
                        <Image src={icon} alt="" width={32} height={32} layout="fixed" />
                        <span>Taerra</span>
                    </a>
                    <p class="tagline">{hero.tagline}</p>
                </div>
                <nav aria-label={footer.elsewhere}>
                    <ul>
                        {nav.map(({label, href, Icon}) => (
                            <li>
                                <a {href}>
                                    <span class="slot" aria-hidden="true">
                                        {Icon ? (
                                            <Icon class="icon" />
                                        ) : (
                                            <img class="discord" src={discord.src} alt="" width="21" height="16" />
                                        )}
                                    </span>
                                    {label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </div>
            <div class="fine">
                <p>{footer.disclaimer}</p>
                <p class="build">
                    {footer.build}{' '}
                    {PUBLIC_COMMIT_HASH === 'dev' ? (
                        PUBLIC_COMMIT_HASH
                    ) : (
                        <a href={commitUrl(PUBLIC_COMMIT_HASH)}>{PUBLIC_COMMIT_HASH.slice(0, 7)}</a>
                    )}
                </p>
            </div>
        </div>
    </div>
    <AerulionFooter />
</footer>

<style>
    .page {
        padding: 56px 0 32px;
        background: var(--stone-900);
        box-shadow: inset 0 2px rgb(255 255 255 / 0.08);
    }

    .top {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 32px;
    }

    .brand {
        display: grid;
        gap: 16px;
    }

    .lockup {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 20px;
        letter-spacing: 0.02em;
        text-decoration: none;
    }

    .tagline {
        max-width: 34ch;
        color: var(--stone-100);
        font-size: 16px;
    }

    ul {
        display: grid;
        gap: 10px;
        padding: 0;
        list-style: none;
    }

    ul a {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--stone-100);
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
    }

    ul a:hover {
        color: var(--white);
    }

    ul a:hover .slot {
        translate: 0 -2px;
    }

    .slot {
        display: grid;
        place-items: center;
        width: 22px;
        height: 16px;
        flex: none;
        color: var(--white);
        transition: translate 0.25s var(--ease-spring);
    }

    .slot :global(.icon) {
        width: 16px;
        height: 16px;
    }

    .discord {
        width: 21px;
        height: 16px;
    }

    .fine {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 24px;
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid var(--stone-700);
        color: var(--stone-200);
        font-size: 13px;
    }

    .build {
        font-family: var(--font-mono);
    }
</style>
