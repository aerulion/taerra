---
import {Image, Picture} from 'astro:assets';
import Rotate from '../icons/rotate.svg';
import backdrop from '../assets/backdrop.png';
import worldTop from '../assets/world-top.png';
import world0 from '../assets/world-0.png';
import world1 from '../assets/world-1.png';
import world2 from '../assets/world-2.png';
import world3 from '../assets/world-3.png';
import {getRelativeLocaleUrl} from 'astro:i18n';
import {copy, links} from '../data/taerra';

const {hero} = copy(Astro.currentLocale);
const [before, live, after] = hero.title;
const worlds = [world0, world1, world2, world3];
const download = getRelativeLocaleUrl(Astro.currentLocale ?? 'en', 'download/');
---

<section id="top" class="hero">
    <Image class="backdrop" src={backdrop} alt="" layout="full-width" loading="eager" />
    <div class="shade"></div>
    <div class="container layout">
        <div class="copy">
            <p class="kicker pixel">{hero.kicker}</p>
            <h1>
                {before}
                <em>{live}</em>
                {after}
            </h1>
            <p class="tagline">{hero.tagline}</p>
            <p class="lede">{hero.lede}</p>
            <div class="actions">
                <a class="btn btn--primary" href={download}>
                    {hero.download}
                </a>
                <a class="btn" href={links.demo}>
                    {hero.demo}
                </a>
            </div>
            <p class="note">{hero.note}</p>
        </div>
        <figure class="world" data-labels={JSON.stringify([...hero.facing, hero.top])}>
            <div class="stage">
                <Picture class="flat" src={worldTop} formats={['avif']} fallbackFormat="webp" width={720} alt="" />
                {worlds.map((world, i) => (
                    <Picture
                        src={world}
                        formats={['avif']}
                        fallbackFormat="webp"
                        width={720}
                        alt={i ? '' : hero.alt}
                        priority={!i}
                    />
                ))}
            </div>
            <figcaption>
                <button class="btn btn--dark" type="button" data-rotate>
                    <Rotate aria-hidden="true" />
                    {hero.rotate}
                </button>
                <span class="side">{hero.facing[0]}</span>
            </figcaption>
        </figure>
    </div>
    <div class="edge"></div>
</section>

<script>
    const TOP = 4;
    const ORDER = [0, 3, 2, 1, TOP];
    const EASE = 'cubic-bezier(0.65, 0, 0.35, 1)';
    const theta = (rotation: number) => 45 - 90 * rotation;
    const folded = (angle: number) => `scale(1.41421, 0.70711) rotate(${angle}deg)`;
    const flat = (angle: number) => `scale(1.15, 1.15) rotate(${angle}deg)`;
    const tilted = (angle: number) => `scale(1, 0.5) rotate(${angle}deg) scale(1, 2)`;
    const lying = (x: number, y: number, angle: number) =>
        `scale(${x}, ${y}) rotate(${angle}deg) scale(0.70711, 1.41421)`;

    for (const figure of document.querySelectorAll<HTMLElement>('.world')) {
        const labels: string[] = JSON.parse(figure.dataset.labels!);
        const side = figure.querySelector('.side')!;
        const [top, ...isos] = [...figure.querySelectorAll<HTMLElement>('.stage > picture')];
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let step = 0;
        let busy = false;

        const play = async (element: HTMLElement, keyframes: Keyframe[], duration: number) => {
            const animation = element.animate(keyframes, {
                duration: still ? 0 : duration,
                easing: EASE,
                fill: 'forwards'
            });
            await animation.finished;
            animation.commitStyles();
            animation.cancel();
        };

        const advance = async () => {
            if (busy) return;
            busy = true;
            const from = ORDER[step];
            step = (step + 1) % ORDER.length;
            const to = ORDER[step];
            side.textContent = labels[to];
            if (to === TOP) {
                const angle = theta(from) + 360;
                await Promise.all([
                    play(
                        isos[from],
                        [
                            {transform: lying(1.41421, 0.70711, 0), opacity: 1},
                            {opacity: 1, offset: 0.15},
                            {opacity: 0, offset: 0.65},
                            {transform: lying(1.15, 1.15, 360 - angle), opacity: 0}
                        ],
                        1600
                    ),
                    play(
                        top,
                        [
                            {transform: folded(angle), opacity: 1},
                            {transform: flat(360), opacity: 1}
                        ],
                        1600
                    )
                ]);
            } else if (from === TOP) {
                await Promise.all([
                    play(
                        top,
                        [
                            {transform: flat(0), opacity: 1},
                            {opacity: 1, offset: 0.9},
                            {transform: folded(theta(to)), opacity: 0}
                        ],
                        1600
                    ),
                    play(
                        isos[to],
                        [
                            {transform: lying(1.15, 1.15, -theta(to)), opacity: 0},
                            {opacity: 0, offset: 0.35},
                            {opacity: 1, offset: 0.85},
                            {transform: lying(1.41421, 0.70711, 0), opacity: 1}
                        ],
                        1600
                    )
                ]);
            } else {
                isos[from].style.zIndex = '0';
                isos[to].style.zIndex = '1';
                await Promise.all([
                    play(
                        isos[from],
                        [
                            {transform: tilted(0), opacity: 1},
                            {opacity: 1, offset: 0.85},
                            {transform: tilted(90), opacity: 0}
                        ],
                        1300
                    ),
                    play(
                        isos[to],
                        [
                            {transform: tilted(-90), opacity: 0},
                            {opacity: 0, offset: 0.15},
                            {opacity: 1, offset: 0.85},
                            {transform: tilted(0), opacity: 1}
                        ],
                        1300
                    )
                ]);
            }
            busy = false;
        };

        const loaded = () => [top, ...isos].every((picture) => picture.querySelector('img')!.complete);
        let visible = false;
        new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(figure);
        const auto = still ? undefined : setInterval(() => visible && !document.hidden && loaded() && advance(), 4200);
        figure.querySelector('[data-rotate]')!.addEventListener('click', () => {
            clearInterval(auto);
            side.setAttribute('aria-live', 'polite');
            advance();
        });
    }
</script>

<style>
    .hero {
        position: relative;
        display: grid;
        grid-template-rows: 1fr auto;
        min-height: calc(100svh - 64px);
        overflow: hidden;
        isolation: isolate;
    }

    .backdrop {
        animation: drift 40s ease-in-out infinite alternate;
    }

    @keyframes drift {
        from {
            scale: 1.04;
            translate: -1% 0;
        }

        to {
            scale: 1.12;
            translate: 1% -1%;
        }
    }

    .copy > * {
        animation: rise 0.9s var(--ease-out) both;
    }

    .copy > :nth-child(2) {
        animation-delay: 0.08s;
    }

    .copy > :nth-child(3) {
        animation-delay: 0.16s;
    }

    .copy > :nth-child(4) {
        animation-delay: 0.24s;
    }

    .copy > :nth-child(5) {
        animation-delay: 0.32s;
    }

    .copy > :nth-child(6) {
        animation-delay: 0.4s;
    }

    .backdrop,
    .shade {
        position: absolute;
        inset: 0;
        z-index: -1;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .shade {
        background: linear-gradient(90deg, rgb(0 0 0 / 0.92) 30%, rgb(0 0 0 / 0.45) 70%, rgb(0 0 0 / 0.3));
    }

    .layout {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        align-items: center;
        gap: 32px;
        padding-block: clamp(48px, 8vw, 96px);
    }

    .copy {
        display: grid;
        gap: 24px;
    }

    h1 {
        font-size: clamp(48px, 6.2vw, 84px);
        font-weight: 900;
        line-height: 0.98;
        letter-spacing: -0.025em;
        text-shadow: 0 4px 24px rgb(0 0 0 / 0.7);
    }

    h1 em {
        color: var(--accent-hi);
        font-style: normal;
    }

    .tagline {
        color: var(--white);
        font-size: clamp(20px, 2vw, 26px);
        font-weight: 600;
        line-height: 1.3;
        text-wrap: balance;
    }

    .lede {
        font-size: 18px;
    }

    .note {
        color: var(--stone-200);
        font-size: 15px;
    }

    .world {
        display: grid;
        justify-items: center;
        gap: 16px;
    }

    .world {
        animation: rise 1.2s 0.2s var(--ease-out) both;
    }

    .stage {
        position: relative;
        z-index: 0;
        display: grid;
        animation: float 5s ease-in-out infinite alternate;
    }

    .world :global(picture) {
        display: block;
        grid-area: 1 / 1;
        opacity: 0;
        pointer-events: none;
    }

    .world :global(picture:nth-of-type(2)) {
        opacity: 1;
    }

    .world :global(img) {
        width: 100%;
        filter: drop-shadow(0 28px 36px rgb(0 0 0 / 0.65));
    }

    figcaption {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 16px;
    }

    figcaption .btn {
        min-height: 40px;
        padding: 0 14px 4px;
        font-size: 15px;
    }

    .side {
        min-width: 21ch;
        color: var(--stone-200);
        font-family: var(--font-display);
        font-size: 10px;
        text-transform: uppercase;
    }

    @media (max-width: 960px) {
        .layout {
            grid-template-columns: minmax(0, 1fr);
        }

        .shade {
            background: linear-gradient(180deg, rgb(0 0 0 / 0.9) 45%, rgb(0 0 0 / 0.5));
        }
    }
</style>
