---
import Cards from './Cards.astro';
import {copy} from '../data/taerra';

const {label, groups} = copy(Astro.currentLocale).features;
---

<section class="section features" aria-label={label}>
    <div class="container">
        {groups.map(({kicker, title, features}) => (
            <div class="group">
                <div class="heading" data-reveal>
                    <p class="kicker pixel">{kicker}</p>
                    <h2 class="title">{title}</h2>
                </div>
                <Cards {features} />
            </div>
        ))}
    </div>
</section>

<style>
    .features {
        padding-top: 0;
    }

    .group + .group {
        margin-top: var(--section);
    }
</style>
