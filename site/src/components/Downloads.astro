---
import {Image} from 'astro:assets';
import Download from '../icons/download.svg';
import backdrop from '../assets/backdrop.png';
import detail from '../assets/detail.png';
import ingame from '../../../branding/ingame/mod-labels.png';
import paper from '../assets/platforms/paper.svg';
import fabric from '../assets/platforms/fabric.png';
import {copy} from '../data/taerra';
import {
    anchor,
    changelog,
    date,
    inline,
    builds,
    latest,
    modrinthUrl,
    commit,
    commitUrl,
    parts,
    type Part
} from '../data/downloads';

const lang = Astro.currentLocale ?? 'en';
const {downloads: t, start} = copy(lang);
const logos = {plugin: paper, mod: fabric};
const newest = new Set(parts.map(latest).flatMap((build) => (build ? [anchor(build)] : [])));
const filters = [
    {value: 'all', label: t.archive.all, logo: undefined, count: builds.length},
    ...parts.map((part: Part) => ({
        value: part,
        label: t.parts[part].label,
        logo: logos[part],
        count: builds.filter((build) => build.part === part).length
    }))
];
const phrase = (text: string) => t.phrases[text] ?? text;
const shots = {plugin: detail, mod: ingame};
const [creditBefore, creditLink, creditAfter] = t.credit;
---

<main class="downloads">
    <section class="intro" aria-labelledby="downloads-title">
        <Image class="backdrop" src={backdrop} alt="" layout="full-width" priority />
        <div class="shade"></div>
        <div class="container">
            <div class="heading">
                <p class="kicker pixel">{t.kicker}</p>
                <h1 id="downloads-title" class="title">
                    {t.title}
                </h1>
                <p class="lede">{t.lede}</p>
            </div>
            <div class="latest">
                {parts.map((part, i) => {
                    const build = latest(part);
                    const {audience, title, text} = t.parts[part];
                    return (
                        <article
                            id={`latest-${part}`}
                            class="card"
                            data-part={part}
                            style={`--stagger: ${i}`}
                            aria-labelledby={`latest-${part}-title`}
                        >
                            <div class="shot">
                                <Image
                                    src={shots[part]}
                                    alt=""
                                    loading="eager"
                                    widths={part === 'mod' ? [800, 1200, 1600] : [480, 720, 960]}
                                    sizes={
                                        part === 'mod'
                                            ? '(max-width: 900px) 143vw, 860px'
                                            : '(max-width: 900px) 100vw, 600px'
                                    }
                                />
                                <p class="audience pixel">{audience}</p>
                            </div>
                            <div class="card-body">
                                <h2 id={`latest-${part}-title`}>
                                    <img class="logo" src={logos[part].src} alt="" width="42" height="42" />
                                    {title}
                                </h2>
                                <p class="text">{text}</p>
                                <p class="needs">{start.requirements[part].needs}</p>
                                {build ? (
                                    <>
                                        <div class="get">
                                            <a class="btn btn--primary" href={modrinthUrl(build)}>
                                                <Download aria-hidden="true" />
                                                {t.modrinth}
                                            </a>
                                            <a class="more" href={`#${anchor(build)}`}>
                                                {t.changes}
                                            </a>
                                        </div>
                                        <p class="facts">
                                            <span class="tag pixel">
                                                {t.build} {build.build}
                                            </span>
                                            {build.channel !== 'release' && (
                                                <span class="tag tag--channel pixel">{t.channels[build.channel]}</span>
                                            )}
                                            <time datetime={build.published}>{date(build.published, lang)}</time>
                                            <span>
                                                {t.minecraft} {build.minecraft.join(', ')}
                                            </span>
                                            <a class="commit" href={commitUrl(commit(build))}>
                                                {commit(build)}
                                            </a>
                                        </p>
                                    </>
                                ) : (
                                    <p class="none">{t.none}</p>
                                )}
                            </div>
                        </article>
                    );
                })}
            </div>
            <dl class="updates">
                <dt class="pixel">{start.requirements.updates.part}</dt>
                <dd>{start.requirements.updates.needs}</dd>
            </dl>
        </div>
        <div class="edge"></div>
    </section>

    <section class="section archive" aria-labelledby="archive-title">
        <div class="container">
            <div class="heading" data-reveal>
                <p class="kicker pixel">{t.archive.kicker}</p>
                <h2 id="archive-title" class="title">
                    {t.archive.title}
                </h2>
                <p class="lede">{t.archive.lede}</p>
            </div>
            {builds.length ? (
                <>
                    <fieldset class="filter">
                        <legend class="visually-hidden">{t.archive.filter}</legend>
                        {filters.map(({value, label, logo, count}) => (
                            <label>
                                <input
                                    class="visually-hidden"
                                    type="radio"
                                    name="part"
                                    {value}
                                    checked={value === 'all'}
                                />
                                {logo && <img class="logo" src={logo.src} alt="" width="28" height="28" />}
                                <span>{label}</span>
                                <span class="count">{count}</span>
                            </label>
                        ))}
                    </fieldset>
                    <ol class="timeline">
                        {builds.map((build) => {
                            const id = anchor(build);
                            const {title} = t.parts[build.part];
                            return (
                                <li {id} class="entry" data-part={build.part}>
                                    <p class="build pixel">
                                        <span>{t.build}</span>
                                        {build.build}
                                    </p>
                                    <div class="body">
                                        <h3 class="name">
                                            <img
                                                class="logo"
                                                src={logos[build.part].src}
                                                alt=""
                                                width="28"
                                                height="28"
                                            />
                                            {title}
                                        </h3>
                                        <p class="meta">
                                            {build.channel !== 'release' && (
                                                <span class="tag tag--channel pixel">{t.channels[build.channel]}</span>
                                            )}
                                            {newest.has(id) && <span class="tag tag--latest pixel">{t.latest}</span>}
                                            <time datetime={build.published}>{date(build.published, lang)}</time>
                                            <span>
                                                {t.minecraft} {build.minecraft.join(', ')}
                                            </span>
                                            <a class="commit" href={commitUrl(commit(build))}>
                                                {commit(build)}
                                            </a>
                                        </p>
                                        <details open={newest.has(id)}>
                                            <summary>{t.changes}</summary>
                                            <div class="changelog">
                                                {changelog(build.changelog).map(({heading, blocks}) => (
                                                    <div class="changes">
                                                        {heading && (
                                                            <h4 class="pixel">{t.sections[heading] ?? heading}</h4>
                                                        )}
                                                        {blocks.map((block) =>
                                                            'list' in block ? (
                                                                <ul>
                                                                    {block.list.map((item) => (
                                                                        <li>
                                                                            {inline(item).map((part) =>
                                                                                part.kind === 'code' ? (
                                                                                    <code>{part.text}</code>
                                                                                ) : part.kind === 'link' ? (
                                                                                    <a href={part.href}>{part.text}</a>
                                                                                ) : (
                                                                                    part.text
                                                                                )
                                                                            )}
                                                                        </li>
                                                                    ))}
                                                                </ul>
                                                            ) : (
                                                                <p>
                                                                    {inline(phrase(block.text)).map((part) =>
                                                                        part.kind === 'code' ? (
                                                                            <code>{part.text}</code>
                                                                        ) : part.kind === 'link' ? (
                                                                            <a href={part.href}>{part.text}</a>
                                                                        ) : (
                                                                            part.text
                                                                        )
                                                                    )}
                                                                </p>
                                                            )
                                                        )}
                                                    </div>
                                                ))}
                                            </div>
                                        </details>
                                    </div>
                                    <div class="get">
                                        <a
                                            class="btn btn--dark"
                                            href={modrinthUrl(build)}
                                            aria-label={`${t.modrinth}: ${title}, ${t.build} ${build.build}`}
                                        >
                                            <Download aria-hidden="true" />
                                            {t.download}
                                        </a>
                                    </div>
                                </li>
                            );
                        })}
                    </ol>
                    <p class="credit">
                        {creditBefore}
                        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">{creditLink}</a>
                        {creditAfter}
                    </p>
                </>
            ) : (
                <p class="empty">{t.archive.empty}</p>
            )}
        </div>
    </section>
</main>

<script>
    const filter = document.querySelector<HTMLElement>('.filter');
    const place = () => {
        const label = filter?.querySelector<HTMLElement>('label:has(:checked)');
        if (!filter || !label) return;
        filter.style.setProperty('--thumb-x', `${label.offsetLeft}px`);
        filter.style.setProperty('--thumb-y', `${label.offsetTop}px`);
        filter.style.setProperty('--thumb-w', `${label.offsetWidth}px`);
        filter.style.setProperty('--thumb-h', `${label.offsetHeight}px`);
        if (!filter.classList.contains('is-placed')) {
            filter.classList.add('is-placed');
            requestAnimationFrame(() => filter.classList.add('is-sliding'));
        }
    };
    filter?.addEventListener('change', () => {
        place();
        navigator.vibrate?.(10);
    });
    if (filter) new ResizeObserver(place).observe(filter);

    const reveal = () => {
        const entry = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
        if (!entry?.classList.contains('entry')) return;
        const all = document.querySelector<HTMLInputElement>('input[name="part"][value="all"]');
        if (all) all.checked = true;
        place();
        entry.querySelector('details')?.setAttribute('open', '');
    };
    place();
    reveal();
    addEventListener('hashchange', reveal);

    const still = matchMedia('(prefers-reduced-motion: reduce)');
    for (const details of document.querySelectorAll<HTMLDetailsElement>('.entry details')) {
        const summary = details.querySelector('summary')!;
        summary.addEventListener('click', (event) => {
            if (still.matches) return;
            event.preventDefault();
            const open = (details.dataset.state ?? (details.open ? 'open' : 'closed')) === 'closed';
            const from = details.offsetHeight;
            details.getAnimations().forEach((animation) => animation.cancel());
            details.dataset.state = open ? 'open' : 'closed';
            details.open = false;
            const closed = details.offsetHeight;
            details.open = true;
            const to = open ? details.offsetHeight : closed;
            const animation = details.animate(
                {height: [`${from}px`, `${to}px`]},
                {duration: 350, easing: 'cubic-bezier(0.22, 1, 0.36, 1)'}
            );
            animation.addEventListener('finish', () => {
                details.open = open;
                delete details.dataset.state;
            });
        });
    }
</script>

<style>
    .intro {
        position: relative;
        overflow: hidden;
        isolation: isolate;
    }

    .intro > .container {
        display: grid;
        gap: clamp(32px, 4vw, 48px);
        padding-block: clamp(48px, 7vw, 96px);
    }

    .intro .heading {
        margin: 0;
    }

    .intro :global(.backdrop),
    .shade {
        position: absolute;
        inset: 0;
        z-index: -1;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .intro :global(.backdrop) {
        animation: drift 40s ease-in-out infinite alternate;
    }

    @keyframes drift {
        from {
            scale: 1.04;
        }

        to {
            scale: 1.1;
            translate: 1% -1%;
        }
    }

    .shade {
        background: linear-gradient(180deg, rgb(0 0 0 / 0.88) 20%, rgb(0 0 0 / 0.7) 60%, rgb(0 0 0 / 0.92));
    }

    .intro .heading > *,
    .card {
        animation: rise 0.9s var(--ease-out) both;
    }

    .intro .heading > :nth-child(2) {
        animation-delay: 0.08s;
    }

    .intro .heading > :nth-child(3) {
        animation-delay: 0.16s;
    }

    .card {
        animation-delay: calc(0.24s + var(--stagger) * 0.1s);
    }

    .latest {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .card {
        position: relative;
        display: grid;
        grid-template-rows: auto 1fr;
        overflow: hidden;
        background: var(--stone-900);
        border: 2px solid var(--black);
        box-shadow: var(--slab-shadow);
        scroll-margin-top: 96px;
    }

    .shot {
        position: relative;
        aspect-ratio: 2 / 1;
        overflow: hidden;
        border-bottom: 2px solid var(--black);
    }

    .shot::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 72%, rgb(30 30 31 / 0.9));
    }

    .shot :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card[data-part='mod'] .shot :global(img) {
        width: 143%;
        max-width: none;
        height: auto;
        margin: -24.1% 0 0 -14.3%;
    }

    .card-body {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-rows: auto auto 1fr auto auto;
        gap: 14px;
        padding: clamp(20px, 2.6vw, 28px) clamp(24px, 3vw, 32px) clamp(24px, 3vw, 32px);
    }

    .audience {
        position: absolute;
        left: clamp(24px, 3vw, 32px);
        bottom: 16px;
        z-index: 1;
        padding: 7px 10px 10px;
        background: var(--accent);
        color: var(--white);
        font-size: 10px;
        box-shadow:
            inset 0 -3px var(--accent-lo),
            inset 2px 2px rgb(255 255 255 / 0.2);
    }

    .card h2 {
        font-size: clamp(30px, 3.4vw, 40px);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.02em;
    }

    .text {
        color: var(--stone-100);
        font-size: 17px;
        text-wrap: pretty;
    }

    .needs {
        color: var(--stone-200);
        font-size: 15px;
    }

    .get {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 20px;
        margin-top: 6px;
    }

    .get .btn :global(svg) {
        width: 16px;
        height: 16px;
    }

    .get .btn:hover :global(svg) {
        animation: nudge 0.5s var(--ease-spring);
    }

    @keyframes nudge {
        40% {
            translate: 0 3px;
        }
    }

    .card .btn {
        min-height: 52px;
        padding-inline: 24px;
        font-size: 18px;
    }

    .more {
        color: var(--stone-100);
        font-size: 15px;
        font-weight: 600;
        text-decoration-color: var(--stone-600);
        text-underline-offset: 4px;
    }

    .more:hover {
        color: var(--white);
        text-decoration-color: var(--accent-hi);
    }

    .commit {
        font-family: var(--font-mono);
    }

    .facts {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 14px;
        color: var(--stone-200);
        font-size: 14px;
    }

    .none {
        color: var(--stone-200);
    }

    .tag {
        display: inline-flex;
        align-items: center;
        height: 24px;
        padding: 0 8px 3px;
        background: var(--stone-700);
        color: var(--stone-100);
        font-size: 8px;
        line-height: 1;
        white-space: nowrap;
        box-shadow:
            inset 0 -3px var(--stone-900),
            inset 2px 2px rgb(255 255 255 / 0.1);
    }

    .tag--channel {
        background: var(--accent-lo);
        color: var(--accent-hi);
        box-shadow:
            inset 0 -3px rgb(0 0 0 / 0.35),
            inset 2px 2px rgb(255 255 255 / 0.12);
    }

    .tag--latest {
        background: var(--accent);
        color: var(--white);
        box-shadow:
            inset 0 -3px var(--accent-lo),
            inset 2px 2px rgb(255 255 255 / 0.2);
    }

    .updates {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px 20px;
        max-width: 80ch;
    }

    .updates dt {
        color: var(--accent-hi);
        font-size: 10px;
    }

    .updates dd {
        color: var(--stone-100);
        font-size: 16px;
    }

    .filter {
        position: relative;
        display: inline-flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-bottom: 32px;
        padding: 4px;
        background: var(--black);
        border: 2px solid var(--stone-900);
        box-shadow: inset 0 2px rgb(0 0 0 / 0.6);
    }

    .filter label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 40px;
        padding: 0 16px 2px;
        color: var(--stone-100);
        font-weight: 700;
        cursor: pointer;
        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .filter label:hover {
        color: var(--white);
        background: var(--stone-800);
    }

    .filter label:has(:checked) {
        background: var(--accent);
        color: var(--white);
        box-shadow:
            inset 0 -3px var(--accent-lo),
            inset 2px 2px rgb(255 255 255 / 0.2);
    }

    .filter label {
        position: relative;
    }

    .filter.is-placed::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: var(--thumb-w);
        height: var(--thumb-h);
        background: var(--accent);
        box-shadow:
            inset 0 -3px var(--accent-lo),
            inset 2px 2px rgb(255 255 255 / 0.2);
        translate: var(--thumb-x) var(--thumb-y);
        pointer-events: none;
    }

    .filter.is-sliding::before {
        transition:
            translate 0.32s var(--ease-spring),
            width 0.32s var(--ease-spring);
    }

    .filter.is-placed label:has(:checked) {
        background: none;
        box-shadow: none;
    }

    .filter label:has(:focus-visible) {
        outline: 2px solid var(--accent-hi);
        outline-offset: 2px;
    }

    .count {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 400;
        opacity: 0.75;
    }

    .archive:has(input[value='plugin']:checked) .entry[data-part='mod'],
    .archive:has(input[value='mod']:checked) .entry[data-part='plugin'] {
        display: none;
    }

    .timeline {
        position: relative;
        display: grid;
        gap: 12px;
        padding: 0;
        list-style: none;
    }

    .entry {
        display: grid;
        grid-template-columns: 112px minmax(0, 1fr) auto;
        gap: 24px;
        align-items: start;
        padding: 24px;
        background: var(--stone-900);
        border: 2px solid var(--black);
        box-shadow: var(--slab-shadow);
        scroll-margin-top: 96px;
        transition: border-color 0.3s ease;
    }

    .entry:target {
        border-color: var(--accent);
        animation: target 1.6s var(--ease-out);
    }

    @keyframes target {
        from,
        20% {
            background: var(--accent-lo);
        }
    }

    details[data-state] {
        overflow: clip;
    }

    .build {
        display: grid;
        gap: 8px;
        font-size: 30px;
    }

    .build span {
        color: var(--stone-200);
        font-size: 8px;
    }

    .name {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 22px;
        font-weight: 800;
        line-height: 1.1;
    }

    .logo {
        width: auto;
        flex: none;
        image-rendering: pixelated;
    }

    .card h2 {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .card h2 .logo {
        height: 42px;
    }

    .name .logo {
        height: 28px;
    }

    .filter .logo {
        height: 28px;
    }

    .credit {
        margin-top: 32px;
        color: var(--stone-200);
        font-size: 13px;
    }

    .body {
        display: grid;
        gap: 12px;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        color: var(--stone-200);
        font-size: 15px;
    }

    summary {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        width: fit-content;
        color: var(--stone-100);
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        list-style: none;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary::before {
        content: '';
        width: 8px;
        height: 8px;
        background: var(--accent-hi);
        clip-path: polygon(0 0, 100% 50%, 0 100%);
        transition: rotate 0.2s var(--ease-out);
    }

    details[open]:not([data-state='closed']) summary::before {
        rotate: 90deg;
    }

    summary:hover {
        color: var(--white);
    }

    .changelog {
        display: grid;
        gap: 16px;
        margin-top: 16px;
        padding: 16px 20px;
        background: var(--black);
        box-shadow: inset 0 2px rgb(0 0 0 / 0.6);
    }

    .changes {
        display: grid;
        gap: 8px;
    }

    .changes h4 {
        color: var(--accent-hi);
        font-size: 10px;
    }

    .changes ul {
        display: grid;
        gap: 6px;
        padding: 0;
        list-style: none;
    }

    .changes li {
        position: relative;
        padding-left: 20px;
        color: var(--stone-100);
        font-size: 16px;
    }

    .changes li::before {
        content: '';
        position: absolute;
        top: 0.6em;
        left: 0;
        width: 8px;
        height: 8px;
        background: var(--stone-600);
    }

    .changes p {
        color: var(--stone-200);
        font-size: 16px;
    }

    .changes code {
        padding: 1px 5px;
        background: var(--stone-800);
    }

    .entry .get {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
    }

    .empty {
        padding: 32px;
        background: var(--stone-900);
        color: var(--stone-200);
        border: 2px solid var(--black);
    }

    @media (max-width: 900px) {
        .latest {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (max-width: 720px) {
        .entry {
            grid-template-columns: minmax(0, 1fr);
            gap: 16px;
            padding: 20px;
        }

        .build {
            display: flex;
            align-items: baseline;
            gap: 12px;
            font-size: 24px;
        }

        .entry .get {
            flex-direction: row;
            flex-wrap: wrap;
            align-items: center;
        }
    }
</style>
