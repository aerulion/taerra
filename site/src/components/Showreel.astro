---
import {Image} from 'astro:assets';
import thumbnail from '../../../branding/images/youtube/thumbnail.png';
import {copy, showreel} from '../data/taerra';

const t = copy(Astro.currentLocale).showreel;
---

{showreel && (
    <section class="section showreel" aria-labelledby="showreel-title">
        <div class="container">
            <div class="heading" data-reveal>
                <p class="kicker pixel">{t.kicker}</p>
                <h2 id="showreel-title" class="title">
                    {t.title}
                </h2>
            </div>
            <div class="player" data-reveal data-video={showreel} data-title={t.frame}>
                <button type="button" class="poster">
                    <Image src={thumbnail} alt="" width={1200} />
                    <span class="btn btn--primary">{t.play}</span>
                </button>
            </div>
            <p class="note">{t.note}</p>
        </div>
    </section>
)}

<script>
    for (const player of document.querySelectorAll<HTMLElement>('[data-video]')) {
        player.querySelector('button')!.addEventListener('click', () => {
            const frame = document.createElement('iframe');
            frame.src = `https://www.youtube-nocookie.com/embed/${player.dataset.video}?autoplay=1`;
            frame.title = player.dataset.title!;
            frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
            player.replaceChildren(frame);
        });
    }
</script>

<style>
    .player {
        aspect-ratio: 16 / 9;
        border: 2px solid var(--black);
        border-bottom: 6px solid var(--accent);
        box-shadow: 0 16px 40px rgb(0 0 0 / 0.6);
    }

    .poster {
        position: relative;
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: none;
        cursor: pointer;
    }

    .poster :global(img),
    .player :global(iframe) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border: 0;
    }

    .poster :global(img) {
        grid-area: 1 / 1;
    }

    .poster .btn {
        grid-area: 1 / 1;
        place-self: end;
        margin: clamp(12px, 4%, 40px);
        pointer-events: none;
    }

    .poster:hover .btn {
        background: var(--accent-hi);
    }

    .note {
        margin-top: 16px;
        color: var(--stone-200);
        font-size: 15px;
    }
</style>
